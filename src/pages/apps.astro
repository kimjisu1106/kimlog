---
import Page from '../layouts/Page.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import { getPosts, hasCatsCI, postHref as href } from '../lib/posts';
import { postDateStr } from '../lib/kst';

const all = await getPosts();

// Projects — apps + summary + project, finished 먼저 then WIP.
const projectPosts = all.filter(
  (p) =>
    p.data.categories.includes('apps') && p.data.categories.includes('summary') && p.data.project,
);
const finished = projectPosts.filter((p) => p.data.status === 'finished');
const wip = projectPosts.filter((p) => p.data.status !== 'finished');
const projects = [...finished, ...wip];

// Dev Log — categories에 log AND apps (대소문자 무시).
const devlogPosts = all.filter((p) => hasCatsCI(p, 'log', 'apps'));
---

<Page title="Apps">
  <ContributionGraph category="apps" />

  <h2>Projects</h2>
  {
    projects.length === 0 ? (
      <p>아직 글이 없습니다.</p>
    ) : (
      <div class="app-grid">
        {projects.map((post) => (
          <a
            class={`app-tile${post.data.status === 'finished' ? ' app-tile--finished' : ''}`}
            href={href(post)}
          >
            <div class="app-tile-top">
              <img
                src={`/assets/images/${post.data.project}.png`}
                alt={post.data.project_name || post.data.title}
                loading="lazy"
                onerror="this.style.display='none'"
              />
              <span class="app-tile-name">
                {post.data.project_name || post.data.title}
                {post.data.status === 'finished' && <span class="devlog-badge"> ✅</span>}
              </span>
            </div>
            {post.data.tags.length > 0 && <span class="app-tile-tag">{post.data.tags.join(' · ')}</span>}
            <span class="app-tile-go">자세히 보기 →</span>
          </a>
        ))}
      </div>
    )
  }

  <hr />
  <h2>Dev Log</h2>
  {
    devlogPosts.length === 0 ? (
      <p>아직 글이 없습니다.</p>
    ) : (
      <ul class="devlog-list">
        {devlogPosts.map((post) => (
          <li>
            {postDateStr(post.data.date)} ｜ <a href={href(post)}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</Page>
