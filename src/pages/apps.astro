---
import Page from '../layouts/Page.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import { getPosts, byCategory } from '../lib/posts';
import { postDateStr } from '../lib/kst';

const all = await getPosts();
const href = (id: string) => encodeURI('/' + id + '/');

// Projects — apps + summary + project, finished 먼저 then WIP.
const projectPosts = all.filter(
  (p) =>
    p.data.categories.includes('apps') && p.data.categories.includes('summary') && p.data.project,
);
const finished = projectPosts.filter((p) => p.data.status === 'finished');
const wip = projectPosts.filter((p) => p.data.status !== 'finished');
const projects = [...finished, ...wip];

// Dev Log — categories에 log AND apps (대소문자 무시).
const lower = (p: (typeof all)[number]) => p.data.categories.map((c) => c.toLowerCase());
const devlogPosts = all.filter((p) => lower(p).includes('log') && lower(p).includes('apps'));
---

<Page title="Apps">
  <ContributionGraph category="apps" />

  <h2>Projects</h2>
  {
    projects.length === 0 ? (
      <p>아직 글이 없습니다.</p>
    ) : (
      <div class="apps-shelf">
        {projects.map((post) => (
          <div class={`apps-card${post.data.status === 'finished' ? ' finished' : ''}`}>
            <div class="apps-card-inner">
              <div class="apps-card-front">
                <img
                  src={`/assets/images/${post.data.project}.png`}
                  alt={post.data.project_name || post.data.title}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
                <span class="apps-card-name">{post.data.project_name || post.data.title}</span>
              </div>
              <div class="apps-card-back">
                <a class="apps-card-btn" href={href(post.id)}>
                  자세히 보기 →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    )
  }

  <hr />
  <h2>Dev Log</h2>
  {
    devlogPosts.length === 0 ? (
      <p>아직 글이 없습니다.</p>
    ) : (
      <ul class="devlog-list">
        {devlogPosts.map((post) => (
          <li>
            {postDateStr(post.data.date)} ｜ <a href={href(post.id)}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</Page>

<script>
  document.querySelectorAll('.apps-shelf .apps-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.apps-card-btn')) return;
      card.classList.toggle('flipped');
    });
  });
</script>
