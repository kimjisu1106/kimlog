---
import Page from '../layouts/Page.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import { getPosts, hasCatsCI, postHref as href } from '../lib/posts';
import { postDateStr } from '../lib/kst';

const all = await getPosts();

const projects = all.filter(
  (p) =>
    p.data.categories.includes('ue5') && p.data.categories.includes('summary') && p.data.project,
);
const devlogPosts = all.filter((p) => hasCatsCI(p, 'log', 'ue5'));
---

<Page title="Unreal Engine">
  <ContributionGraph category="ue5" />

  <h2>Projects</h2>
  {
    projects.length === 0 ? (
      <p>아직 글이 없습니다.</p>
    ) : (
      <ul class="devlog-list">
        {projects.map((post) => (
          <li>
            {postDateStr(post.data.date)} ｜{' '}
            <a href={href(post)}>{post.data.project_name || post.data.title}</a>
            {post.data.status === 'finished' && <span class="devlog-badge">✅</span>}
          </li>
        ))}
      </ul>
    )
  }

  <hr />
  <h2>Dev Log</h2>
  {
    devlogPosts.length === 0 ? (
      <p>아직 글이 없습니다.</p>
    ) : (
      <ul class="devlog-list">
        {devlogPosts.map((post) => (
          <li>
            {postDateStr(post.data.date)} ｜ <a href={href(post)}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</Page>
