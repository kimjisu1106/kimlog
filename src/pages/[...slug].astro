---
import Post from '../layouts/Post.astro';
import { getPosts, seriesFor, suggestedFor } from '../lib/posts';

// post.id = _content 상대경로 verbatim → params.slug 슬래시가 경로 구분자로 유지되어
// trailingSlash 'always' + build.format 'directory'와 함께 Jekyll permalink를 그대로 재현한다.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      series: seriesFor(post, posts),
      suggested: suggestedFor(post, posts),
    },
  }));
}

const { post, series, suggested } = Astro.props;
---

<Post post={post} series={series} suggested={suggested} />
