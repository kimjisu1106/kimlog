---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showTitle?: boolean;
}

const { title, description, showTitle = true } = Astro.props;
---

<Base title={title} description={description}>
  <Header />
  <main class="page-content" aria-label="Content">
    <div class="wrapper">
      {title && showTitle && <h1 class="post-title">{title}</h1>}
      <slot />
    </div>
  </main>
  <Footer />
</Base>
